<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SmartCampus</display-name>

    <!-- 访问应用根路径时默认打开登录页 -->
    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>

    <!--
        Servlet 通过 @WebServlet 注解注册，此处无需重复配置：
          /login         -> LoginServlet        登录校验（写入 Session）
          /register      -> RegisterServlet     注册（服务端二次校验后入库）
          /logout        -> LogoutServlet       注销（销毁 Session）
          /current-user  -> CurrentUserServlet  查询当前登录用户
        若改用 web.xml 方式（不用注解），可按下面格式补充：
        <servlet>
            <servlet-name>LoginServlet</servlet-name>
            <servlet-class>com.smartcampus.servlet.LoginServlet</servlet-class>
        </servlet>
        <servlet-mapping>
            <servlet-name>LoginServlet</servlet-name>
            <url-pattern>/login</url-pattern>
        </servlet-mapping>
    -->

</web-app>
